# EcoPulse Server Configuration Template
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas connection string on Render / Production:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/ecopulse?retryWrites=true&w=majority

# Frontend URL (e.g. https://your-app.vercel.app or * for open CORS)
CLIENT_URL=*
